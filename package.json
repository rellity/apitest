    "alpinejs": "^3.17.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.7",
    "htmx.org": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/alpinejs": "^3",
