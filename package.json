{
  "name": "apitest",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "bun run build.ts",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "db:studio": "bun --bun drizzle-kit studio",
